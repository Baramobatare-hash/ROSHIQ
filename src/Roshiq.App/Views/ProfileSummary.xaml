<UserControl x:Class="Roshiq.App.Views.ProfileSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <DockPanel>
        <Border x:Name="ProfileAvatar" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="3" Margin="0,0,12,0"
                Background="{DynamicResource Panel3}" VerticalAlignment="Top">
            <ov:Icon x:Name="ProfileAvatarIcon" Glyph="{StaticResource I.Shield}" Size="16" Brush="{DynamicResource Faint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel>
            <TextBlock x:Name="ProfileName" Style="{StaticResource Value}" FontWeight="Bold" />
            <TextBlock x:Name="ProfileSub" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            <TextBlock x:Name="ProfileRank" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />
            <Grid x:Name="ProfileRankChartBox" Height="38" Margin="0,6,12,0" Visibility="Collapsed" Background="Transparent">
                <Canvas x:Name="ProfileRankChart" ClipToBounds="False" SizeChanged="ProfileRankChart_SizeChanged" />
            </Grid>
            <TextBlock x:Name="ProfileCalib" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />
            <TextBlock x:Name="ProfileWeak" Style="{StaticResource MutedText}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />
        </StackPanel>
    </DockPanel>
</UserControl>
